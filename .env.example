# -----------------------------------------------------------------------------
# AI Service System — environment variables (copy to .env and edit).
# -----------------------------------------------------------------------------

# --- Service identity ---
SERVICE_NAME=ai-service-system
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- HTTP server ---
HOST=0.0.0.0
PORT=8001
API_PREFIX=/api/v1

# --- CORS (comma-separated origins; "*" allowed in dev) ---
CORS_ORIGINS=["*"]

# --- Model weights directory ---
# - Local dev: ./models
# - Docker:    /app/models  (mounted from ./models in docker-compose.yml)
MODELS_DIR=./models

# --- Inference runtime ---
USE_GPU=true
ORT_INTRA_OP_THREADS=0     # 0 = let ONNX Runtime decide

# --- Detector tuning ---
DETECTOR_SCORE_THRESHOLD=0.5
DETECTOR_NMS_THRESHOLD=0.4
DETECTOR_MAX_FACES=10

# --- Upload guard ---
MAX_UPLOAD_BYTES=10485760  # 10 MB
